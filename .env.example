# Copy to ".env" and fill in to use the real Supabase backend.
# Leave VITE_DB_MODE=memory to run fully offline with the in-memory dev store.

# "memory"  -> in-browser dev store (data persists in localStorage, resets if cleared)
# "supabase"-> real PostgreSQL persistence (requires the two keys below)
VITE_DB_MODE=memory

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
